    if hookfunction and rawGet then
        hookfunction(game.HttpGet, function(self, url, ...)
            if fired then return rawGet(self, url, ...) end
            if isSensitive(url) then
                bust("HTTP GET 敏感拦截", url)
                return ""
            end
            return rawGet(self, url, ...)
        end)
    end
end)

