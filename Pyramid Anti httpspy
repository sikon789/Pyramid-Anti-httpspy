local SPY_FINGERPRINTS = {
    "Log copied to clipboard!", "HTTP GET", "HTTP POST", "createLogEntry",
    "Your exploit is not supported!", "HTTP Spy made by", "httplogs.txt",
    "HookSynRequest", "BlockUrl", "ProxyHost", "__namecall", 
    "HttpSpyLogger", "Http Spy",
}

local function quickCheck()
    if isLuaFunction(game.HttpGet) then return true, "HttpGet 被 Hook" end
    if isLuaFunction(game.HttpPost) then return true, "HttpPost 被 Hook" end
    return false, nil
end

local function guiQuickCheck()
    for _, v in ipairs(game.CoreGui:GetChildren()) do
        if v:IsA("ScreenGui") then
            local name = v.Name:lower()
            if name:find("httpspy", 1, true) or name:find("http_spy", 1, true) or name:find("simplespy", 1, true) then
                return true, "CoreGui:" .. v.Name
            end
        end
    end
    if gethui then
        for _, v in ipairs(gethui():GetChildren()) do
            if v:IsA("ScreenGui") then
                local name = v.Name:lower()
                if name:find("httpspy", 1, true) or name:find("http_spy", 1, true) or name:find("simplespy", 1, true) then
                    return true, "HUI:" .. v.Name
                end
            end
        end
    end
    return false, nil
end

local function gcQuickScan()
    if not getgc then return false, nil end
    local ok, gc = pcall(getgc, true)
    if not ok or type(gc) ~= "table" then return false, nil end

    local limit = math.min(#gc, 50)
    for i = 1, limit do
        local v = gc[i]
        if type(v) == "function" then
            local hit = false
            pcall(function()
                local ok2, consts = pcall(debug.getconstants, v)
                if ok2 and consts then
                    for _, c in ipairs(consts) do
                        local cs = tostring(c)
                        for _, fp in ipairs(SPY_FINGERPRINTS) do
                            if cs:find(fp, 1, true) then hit = true break end
                        end
                        if hit then break end
                    end
                end
            end)
            if hit then return true, "GC 特征匹配" end
        end
    end
    return false, nil
end

local function onDetected(reason, details)
    if triggered then return end
    triggered = true
    SendWebhook(reason, details)
    task.delay(0.3, function() 
        pcall(function() 
            plr:Kick("🚫 检测到非法工具 (HttpSpy)\n✅ 你的行为已被记录\n🛡️ Anti-HttpSpy by Pyramid") 
        end) 
    end)
end

local function isSensitiveUrl(url)
    if type(url) ~= "string" then return false end
    local u = url:lower()
    if WEBHOOK_URL then
        local id = WEBHOOK_URL:match("(%d+)")
        if id and u:find(id, 1, true) then return false end
    end
    return u:find("webhook") or u:find("discord.com") or u:find("githubusercontent")
end

pcall(function()
    if hookfunction and origHttpGet then
        hookfunction(game.HttpGet, function(self, url, ...)
            if triggered then return origHttpGet(self, url, ...) end
            if isSensitiveUrl(url) then onDetected("HTTP GET 敏感拦截", url) return "" end
            return origHttpGet(self, url, ...)
        end)
    end
end)

pcall(function()
    if hookfunction and origHttpPost then
        hookfunction(game.HttpPost, function(self, url, ...)
            if triggered then return origHttpPost(self, url, ...) end
            if isSensitiveUrl(url) then onDetected("HTTP POST 敏感拦截", url) return "" end
            return origHttpPost(self, url, ...)
        end)
    end
end)

