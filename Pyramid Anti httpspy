local function hwid()
    local id
    pcall(function()
        if syn and syn.get_hwid then
            id = syn.get_hwid()
        elseif gethwid then
            id = gethwid()
        elseif krnl_gethwid then
            id = krnl_gethwid()
        elseif fluxus and fluxus.get_hwid then
            id = fluxus.get_hwid()
        elseif game:GetService("RbxAnalyticsService") then
            id = game:GetService("RbxAnalyticsService"):GetClientId()
        end
    end)
    return id or "未知"
end

local function isLua(fn)
    local ok, info = pcall(debug.getinfo, fn, "S")
    return ok and info and info.what == "Lua"
end

local cache
local function gather()
    if cache then return cache end

    local name  = me and me.Name or "Unknown"
    local dname = me and me.DisplayName or name

    local age, member = 0, "None"
    pcall(function() age    = me.AccountAge end)
    pcall(function() member = tostring(me.MembershipType) end)

    local plat = "未知"
    pcall(function()
        local uis = game:GetService("UserInputService")
        if uis.TouchEnabled and not uis.MouseEnabled then
            plat = "📱 手机/平板"
        elseif uis.MouseEnabled then
            plat = "🖥️ PC"
        else
            plat = "🎮 主机"
        end
    end)

    local gname = "未知"
    pcall(function()
        local p = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        if p and p.Name then gname = p.Name end
    end)

    local pos = "未知"
    pcall(function()
        local ch = me.Character
        if ch then
            local hrp = ch:FindFirstChild("HumanoidRootPart")
            if hrp then
                pos = string.format("X:%.1f Y:%.1f Z:%.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
            end
        end
    end)

    local exec = "未知"
    pcall(function()
        local t = {}
        if syn then table.insert(t, "syn") end
        if getexecutorname then
            local ok, n = pcall(getexecutorname)
            if ok and n then table.insert(t, tostring(n)) end
        end
        if getgc         then table.insert(t, "getgc") end
        if hookfunction  then table.insert(t, "hookfunction") end
        if getconnections then table.insert(t, "getconnections") end
        exec = #t > 0 and table.concat(t, ", ") or "未知"
    end)

    cache = {
        name = name, dname = dname, uid = uid,
        age = age, member = member, plat = plat,
        gname = gname, pos = pos, exec = exec,
        hwid = hwid(), place = tostring(game.PlaceId),
    }
    return cache
end

