                {name = "📝 详情", value = tostring(details or "-"), inline = false},
                {name = "━ ━ ━ ━ ━ ━ ━ ━ ━ ━", value = "**玩家信息**", inline = false},
                {name = "👤 用户名", value = info.name .. " (@ " .. info.dname .. ")", inline = true},
