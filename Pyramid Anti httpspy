local gcHooked, gcSig = gcQuickScan()
if gcHooked then onDetected("启动检测", gcSig) return end

local lastQuick = 0
local lastGui = 0
local lastFull = 0
local startTime = tick()

RunService.Heartbeat:Connect(function()
    if triggered then return end
    local now = tick()
    if now - startTime < 0.5 then return end

    if now - lastQuick >= 0.3 then
        lastQuick = now
        local hooked, sig = quickCheck()
        if hooked then onDetected("心跳扫描", sig) return end
    end

    if now - lastGui >= 1.5 then
        lastGui = now
        local guiHooked, guiSig = guiQuickCheck()
        if guiHooked then onDetected("心跳扫描", guiSig) return end
    end

    if now - lastFull >= 3 then
        lastFull = now
        task.spawn(function()
            local gcHooked, gcSig = gcQuickScan()
            if gcHooked and not triggered then onDetected("心跳扫描", gcSig) end
        end)
    end
end)
