        pcall(function()
            me:Kick("🚫 检测到非法工具 (HttpSpy)\n✅ 你的行为已被记录\n🛡️ Anti-HttpSpy by Pyramid")
        end)
    end)
end

local function isSensitive(url)
    if type(url) ~= "string" then return false end
    local u = url:lower()

    if HOOK then
        local id = HOOK:match("(%d+)")
        if id and u:find(id, 1, true) then return false end
    end

    return u:find("webhook")
        or u:find("discord.com")
        or u:find("githubusercontent")
end

